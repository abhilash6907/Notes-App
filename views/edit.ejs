<!DOCTYPE html>
<html lang="en">
<head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <title>Document</title>
   <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
 <div class="main w-full min-h-screen bg-zinc-900 p-10 text-white">
      <a class="text-blue-500 hover:underline inline-block mb-10" href="/">Go Back to Home</a>
       <form action="/edit" method="POST" class="space-y-5">
        <input
          type="text"
          placeholder="previous name"
          class="w-full px-4 py-2 bg-zinc-700 text-white placeholder-gray-400 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
          name="previous"
          value="<%= filename %>"
          required
        />

       <input
          type="text"
          placeholder="new name"
          class="w-full px-4 py-2 bg-zinc-700 text-white placeholder-gray-400 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
          name="new" 
         
          required
        />

        <button
          type="submit"
          class="w-full py-2 bg-yellow-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition-colors"
        >
          Update Name
        </button>
      </form>
   </div>
</body>
</html>
